# ── Required ────────────────────────────────────────────────────────────────
# Free Google AI Studio key: https://aistudio.google.com/apikey
# The free tier is rate limited per minute and per day. When it runs out the
# site says so and points the customer at Nino's phone — nothing breaks.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000

# Chat widget model. Flash is free and fast; flash-lite is faster and cheaper
# if the widget gets busy.
NINO_CHAT_MODEL=gemini-2.5-flash
# Photo estimator model. Needs vision, so keep it on Flash or better.
NINO_VISION_MODEL=gemini-2.5-flash

# Automatic contact delivery is disabled until explicitly approved and enabled.
# Reuse the existing SMTP integration with Resend or another verified provider.
# Never put real secrets in this file. Use server-side production secrets only.
CONTACT_DELIVERY_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# Bare address on an approved, provider-verified domain (no display name).
SMTP_FROM=
# One approved owner mailbox. Customer input can never set the recipient.
LEAD_TO=
# Separate scope: automatic photo-estimate notifications remain disabled.
ESTIMATE_EMAIL_ENABLED=false
# Setup, verification and rollback: docs/contact-delivery-review.md
